T>;\\\\ninterface ClassDecoratorContext<C> {\\\\n  readonly kind: \\\\\\\"class\\\\\\\";\\\\n  readonly name: string | undefined;\\\\n  addInitializer(initializer: (this: C) => void): void;\\\\n}\\\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\n\\\",\\\"path\\\":\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"sha256\\\":\\\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\\\"},{\\\"content\\\":\\\"declare const component: typeof tsfgComponent;\\\\ndeclare function system(target: unknown): unknown;\\\\ninterface Symbol {}\\\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\\\ninterface Array<T> extends Iterable<T> {}\\\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\\\ninterface Query<T extends unknown[]> {\\\\n readonly __query: T;\\\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\\\n}\\\\ntype Read<T> = SystemQueryReadView<T>;\\\\ntype Write<T> = T;\\\\n\\\",\\\"path\\\":\\\"/src/system-query-context.d.ts\\\",\\\"sha256\\\":\\\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\\\"}],\\\"rootFile\\\":\\\"/src/main.ts\\\",\\\"sourceRoot\\\":\\\"/src\\\",\\\"target\\\":{\\\"llvmDataLayout\\\":\\\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\\\",\\\"pointerBits\\\":\\\"64\\\",\\\"target\\\":\\\"windows-x86_64-msvc\\\",\\\"triple\\\":\\\"x86_64-pc-windows-msvc\\\"}},\\\"schemaHash\\\":\\\"sha256:7b47b293ae3feb815e10b651ea9e2b0994bb894e96544379dcf2ba3f15e