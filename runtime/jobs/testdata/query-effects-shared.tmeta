 function integrate(q: Query<[Write<Position>, Read<Position>]>, dt: f32): void {\\\\n for(const [p,v] of q){\\\\n  p.x += v.x * dt;\\\\n  p.y += v.y * dt;\\\\n }\\\\n}\\\\n\\\",\\\"path\\\":\\\"/src/main.ts\\\",\\\"sha256\\\":\\\"8f56f42194e8aa4e8fb2f8e91e9376d16765890a066c650c1063fc9d455c9131\\\",\\\"utf16Length\\\":333},{\\\"byteLength\\\":1025,\\\"content\\\":\\\"// SPDX-License-Identifier: MIT\\\\ninterface Object {}\\\\ninterface Function {}\\\\ninterface CallableFunction {}\\\\ninterface NewableFunction {}\\\\ninterface IArguments {}\\\\ninterface String {}\\\\ninterface Number {}\\\\ninterface Boolean {}\\\\ninterface RegExp {}\\\\ninterface Array<T> { [n: number]: T; length: number; }\\\\ntype i8 = number;\\\\ntype i16 = number;\\\\ntype i32 = number;\\\\ntype i64 = number;\\\\ntype isize = number;\\\\ntype u8 = number;\\\\ntype u16 = number;\\\\ntype u32 = number;\\\\ntype u64 = number;\\\\ntype usize = number;\\\\ntype f32 = number;\\\\ntype f64 = number;\\\\ntype bool = boolean;\\\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\\\ninterface ClassDecoratorContext<C> {\\\\n  readonly kind: \\\\\\\"class\\\\\\\";\\\\n  readonly name: string | undefined;\\\\n  addInitializer(initializer: (this: C) => void): void;\\\\n}\\\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\n\\\",\\\"path\\\":\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"sha256\\\":\\\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\\\",\\\"utf16Length\\\":1025},{\\\"byteLength\\\":839,\\\"content\\\":\\\"declare const component: typeof tsfgComponent;\\\\ndeclare function system(target: unknown): unknown;\\\\ninterface Symbol {}\\\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\\\ninterface Array<T> extends Iterable<T> {}\\\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\\\ninterface Query<T extends unknown[]> {\\\\n readonly __query: T;\\\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\\\n}\\\\ntype Read<T> = SystemQueryReadView<T>;\\\\ntype Write<T> = T;\\\\n\\\",\\\"path\\\":\\\"/src/system-query-context.d.ts\\\",\\\"sha256\\\":\\\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\\\",\\\"utf16Length\\\":839}],\\\"positionUnit\\\":\\\"utf16\\\",\\\"rootFile\\\":\\\"/src/main.ts\\\",\\\"sourceRoot\\\":\\\"/src\\\",\\\"target\\\":{\\\"llvmDataLayout\\\":\\\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\\\",\\\"pointerBits\\\":\\\"64\\\",\\\"target\\\":\\\"windows-x86_64-msvc\\\",\\\"triple\\\":\\\"x86_64-pc-windows-msvc\\\"}},\\\"scalarHelpers\\\":[],\\\"systems\\\":[{\\\"bodyRange\\\":{\\\"end\\\":332,\\\"start\\\":264},\\\"declaration\\\":{\\\"id\\\":\\\"sha256:76370bbef0d1bad4ba5bb05b64f89f46ccc83e79c12bd33320f98ee4faa910e9\\\",\\\"kind\\\":\\\"KindFunctionDeclaration\\\",\\\"name\\\":\\\"integrate\\\",\\\"nameRange\\\":{\\\"end\\\":203,\\\"start\\\":194},\\\"range\\\":{\\\"end\\\":332,\\\"start\\\":170},\\\"sourcePath\\\":\\\"/src/main.ts\\\"},\\\"loops\\\":[{\\\"bindingRange\\\":{\\\"end\\\":282,\\\"start\\\":277},\\\"bindings\\\":[{\\\"componentType\\\":\\\"nominal:0256909412cc8677599e74e880824548e7715f5fa6bcde6dfc1ee0bfdb3270f5\\\",\\\"declaration\\\":{\\\"id\\\":\\\"sha256:bb6dc07b8cded540d7ca8dbfd894659bec4a3b7f93256e6be51e48135d9259aa\\\",\\\"kind\\\":\\\"KindBindingElement\\\",\\\"name\\\":\\\"p\\\",\\\"nameRange\\\":{