},\\\"sourcePath\\\":\\\"/src/minimal-arrays-v8.d.ts\\\"},{\\\"constructor\\\":null,\\\"id\\\":\\\"void\\\",\\\"kind\\\":\\\"void\\\"}]},\\\"requestId\\\":\\\"sha256:2552c4e2e18339603ff16ab21824f0986d3ad6adbcf841a13f22bdad6d17bb0c\\\",\\\"schemaHash\\\":\\\"sha256:a35185acc806a6095b3e80f6753bbf0cc314f4bde823b75ef5813843159ccce1\\\",\\\"version\\\":5}\\n\",\"sourceRequest\":\"{\\\"family\\\":\\\"tsfg.system-query-facts-request-candidate\\\",\\\"input\\\":{\\\"config\\\":{\\\"allowJs\\\":false,\\\"noEmit\\\":true,\\\"strict\\\":true},\\\"declarations\\\":{\\\"paths\\\":[\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"/src/system-query-context.d.ts\\\"],\\\"version\\\":\\\"minimal-arrays-v8\\\"},\\\"files\\\":[{\\\"content\\\":\\\"// complete original view-helper Program: emoji 😀\\\\n@component\\\\nexport class Position { x:f32=0; y:f32=0; }\\\\n@component\\\\nexport class Velocity { x:f32=0; y:f32=0; }\\\\nfunction readX(p:Read<Position>):f32{return p.x;}\\\\nfunction scaledX(p:Read<Position>,dt:f32):f32{return readX((p))*dt;}\\\\nfunction update(p:Write<Position>,v:Read<Velocity>,dt:f32):f32{return p.x += v.x*dt;}\\\\n@system\\\\nexport function integrate(q:Query<[Write<Position>,Read<Velocity>]>,dt:f32):void{\\\\n for(const [p,v] of q){\\\\n  p.x = update((p),v,dt);\\\\n  p.y += scaledX((p),dt);\\\\n }\\\\n}\\\\nexport function unused(v:i32):i32{return v+1;}\\\\nclass Box {value:i32=1;}\\\\n\\\",\\\"path\\\":\\\"/src/main.ts\\\",\\\"sha256\\\":\\\"9d753390e712cbd960f6a57057ef80622e920ccb5708f731b6acfd5024a8d2f1\\\"},{\\\"content\\\":\\\"// SPDX-License-Identifier: MIT\\\\ninterface Object {}\\\\ninterface Function {}\\\\ninterface CallableFunction {}\\\\ninterface NewableFunction {}\\\\ninterface IArguments {}\\\\ninterface String {}\\\\ninterface Number {}\\\\ninterface Boolean {}\\\\ninterface RegExp {}\\\\ninterface Array<T> { [n: number]: T; length: number; }\\\\ntype i8 = number;\\\\ntype i16 = number;\\\\ntype i32 = number;\\\\ntype i64 = number;\\\\ntype isize = number;\\\\ntype u8 = number;\\\\ntype u16 = number;\\\\ntype u32 = number;\\\\ntype u64 = number;\\\\ntype usize = number;\\\\ntype f32 = number;\\\\ntype f64 = number;\\\\ntype bool = boolean;\\\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\\\ninterface ClassDecoratorContext<C> {\\\\n  readonly kind: \\\\\\\"class\\\\\\\";\\\\n  readonly name: string | undefined;\\\\n  addInitializer(initializer: (this: C) => void): void;\\\\n}\\\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\n\\\",\\\"path\\\":\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"sha256\\\":\\\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\\\"},{\\\"content\\\":\\\"declare const component: typeof tsfgComponent;\\\\ndeclare function system(target: unknown): unknown;\\\\ninterface Symbol {}\\\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\\\ninterface Array<T> extends Iterable<T> {}\\\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\\\ninterface Query<T extends unknown[]> {\\\\n readonly __query: T;\\\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\\\n}\\\\ntype Read<T> = SystemQueryReadView<T>;\\\\ntype Write<T> = T;\\\\n\\\",\\\"path\\\":\\\"/src/system-query-context.d.ts\\\",\\\"sha256\\\":\\\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\\\"}],\\\"rootFile\\\":\\\"/src/main.ts\\\",\\\"sourceRoot\\\":\\\