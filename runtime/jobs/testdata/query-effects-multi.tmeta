ain.ts\\\"},\\\"runtimeKey\\\":\\\"sha256:d48a1ff9baaeb81bace112c30e444622bae2b53c8c2907dfb51911d58c02b3ec\\\",\\\"sourcePath\\\":\\\"/src/main.ts\\\"},{\\\"constructor\\\":null,\\\"declarationRange\\\":{\\\"end\\\":444,\\\"start\\\":426},\\\"id\\\":\\\"u32\\\",\\\"kind\\\":\\\"scalar\\\",\\\"name\\\":\\\"u32\\\",\\\"nameRange\\\":{\\\"end\\\":434,\\\"start\\\":431},\\\"sourcePath\\\":\\\"/src/minimal-arrays-v8.d.ts\\\"},{\\\"constructor\\\":null,\\\"id\\\":\\\"void\\\",\\\"kind\\\":\\\"void\\\"}]},\\\"requestId\\\":\\\"sha256:5cf0305905534342712c7f7bfe6d9c235f3821ec771237b654a122d44bf7d928\\\",\\\"schemaHash\\\":\\\"sha256:32326256ba49bb78f12118d211b520c0f84aa8001422004e8d17dce86d8b814e\\\",\\\"version\\\":6}\\n\",\"sourceRequest\":\"{\\\"family\\\":\\\"tsfg.system-query-facts-request-candidate\\\",\\\"input\\\":{\\\"config\\\":{\\\"allowJs\\\":false,\\\"noEmit\\\":true,\\\"strict\\\":true},\\\"declarations\\\":{\\\"paths\\\":[\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"/src/system-query-context.d.ts\\\"],\\\"version\\\":\\\"minimal-arrays-v8\\\"},\\\"files\\\":[{\\\"content\\\":\\\"// Official multi-system Query facts; UTF16 anchor check: 😀.\\\\n@component export class Position {x:f32=0;y:f32=0;}\\\\n@component export class Velocity {x:f32=0;}\\\\n@system export function readPosition(q:Query<[Read<Position>]>):void {}\\\\n@system export function readPosition2(q:Query<[Read<Position>]>):void {}\\\\n@system export function writePositionX(q:Query<[Write<Position>]>,dt:f32):void {\\\\n for(const [p] of q){p.x += dt;}\\\\n}\\\\n@system export function writePositionY(q:Query<[Write<Position>]>,dt:f32):void {\\\\n for(const [p] of q){p.y += dt;}\\\\n}\\\\n@system export function writeVelocity(q:Query<[Write<Velocity>]>,dt:f32):void {\\\\n for(const [v] of q){v.x += dt;}\\\\n}\\\\n@system export function copyPositionToVelocity(q:Query<[Read<Position>,Write<Velocity>]>,dt:f32):void {\\\\n for(const [p,v] of q){v.x = p.x * dt;}\\\\n}\\\\n@system export function aliasPosition(q:Query<[Write<Position>,Read<Position>]>,dt:f32):void {\\\\n for(const [p,r] of q){p.x += r.y * dt;}\\\\n}\\\\n\\\",\\\"path\\\":\\\"/src/main.ts\\\",\\\"sha256\\\":\\\"b01217c6155b8790171873ead905335605e32ee377f92f90e4352de83507712c\\\"},{\\\"content\\\":\\\"// SPDX-License-Identifier: MIT\\\\ninterface Object {}\\\\ninterface Function {}\\\\ninterface CallableFunction {}\\\\ninterface NewableFunction {}\\\\ninterface IArguments {}\\\\ninterface String {}\\\\ninterface Number {}\\\\ninterface Boolean {}\\\\ninterface RegExp {}\\\\ninterface Array<T> { [n: number]: T; length: number; }\\\\ntype i8 = number;\\\\ntype i16 = number;\\\\ntype i32 = number;\\\\ntype i64 = number;\\\\ntype isize = number;\\\\ntype u8 = number;\\\\ntype u16 = number;\\\\ntype u32 = number;\\\\ntype u64 = number;\\\\ntype usize = number;\\\\ntype f32 = number;\\\\ntype f64 = number;\\\\ntype bool = boolean;\\\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\\\ninterface ClassDecoratorContext<C> {\\\\n  readonly kind: \\\\\\\"class\\\\\\\";\\\\n  readonly name: string | undefined;\\\\n  addInitializer(initializer: (this: C) => void): void;\\\\n}\\\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\n\\\",\\\"path\\\":\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"sha256\\\":\\\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\\\"},{\\\"content\\\":\\\"declare const component: typeof tsfgComponent;\\\\ndeclare function system(target: unknown): unknown;\\\\ninterface Symbol {}\\\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\\\ninterface Array<T> extends Iterable<T> {}\\\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\\\ninterface Query<T extends unknown[]> {\\\\n readonly __query: T;\\\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\\\n}\\\\ntype Read<T> = SystemQueryReadView<T>;\\\\ntype Write<T> = T;\\\\n\\\",\\\"path\\\":\\\"/src/system-query-context.d.ts\\\",\\\"sha256\\\":\\\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\\\"}],\\\"rootFile\\\":\\\"/src/main.ts\\\",\\\"sourceRoot\\\":\\\"/src\\\",\\\"target\\\":{\\\"llvmDataLayout\\\":\\\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\\\",\\\"pointerBits\\\":\\\"64\\\",\\\"target\\\":\\\"windows-x86_64-msvc\\\",\\\"triple\\\":\\\"x86_64-pc-windows-msvc\\\"}},\\\"schemaHash\\\":\\\"sha256:32326256ba49bb78f12118d211b520c0f84aa8001422004e8d17dce86d8b814e\\\",\\\"version\\\":6}\\n\",\"target\":{\"llvmDataLayout\":\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\",\"pointerBits\":\"64\",\"target\":\"windows-x86_64-msvc\",\"triple\":\"x86_64-pc-windows-msvc\"}}","payloadHash":"sha256:96763316e0fa391a285e3f645d500cb2ddab300ec2f2b7dd4e4af419483018ce","schemaHash":"sha256:d598644bbd5360feb48a17cb2511dc93b4dbb2785d2a3f111759dfb6c1b2c69b","version":2}
