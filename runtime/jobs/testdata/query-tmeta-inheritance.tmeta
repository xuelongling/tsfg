or\\\":null,\\\"id\\\":\\\"void\\\",\\\"kind\\\":\\\"void\\\"}]},\\\"requestId\\\":\\\"sha256:e3e07cea503f25c01339fe209c03685b91278b3b28a07162b14da60e952db3f3\\\",\\\"schemaHash\\\":\\\"sha256:32326256ba49bb78f12118d211b520c0f84aa8001422004e8d17dce86d8b814e\\\",\\\"version\\\":6}\\n\",\"sourceRequest\":\"{\\\"family\\\":\\\"tsfg.system-query-facts-request-candidate\\\",\\\"input\\\":{\\\"config\\\":{\\\"allowJs\\\":false,\\\"noEmit\\\":true,\\\"strict\\\":true},\\\"declarations\\\":{\\\"paths\\\":[\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"/src/system-query-context.d.ts\\\"],\\\"version\\\":\\\"minimal-arrays-v8\\\"},\\\"files\\\":[{\\\"content\\\":\\\"// complete architecture Query source: emoji 😀\\\\n@component class Base {x:f32=0;y:f32=0;}\\\\n@component\\\\nexport class Position extends Base {x:f32=0;y:f32=0;}\\\\n@component\\\\nexport class Velocity { x: f32 = 0; y: f32 = 0; }\\\\n@system\\\\nexport function integrate(q: Query<[Write<Position>, Read<Velocity>]>, dt: f32): void {\\\\n for(const [p,v] of q){\\\\n  p.x += v.x * dt;\\\\n  p.y += v.y * dt;\\\\n }\\\\n}\\\\n\\\",\\\"path\\\":\\\"/src/main.ts\\\",\\\"sha256\\\":\\\"710bbe91d7ba8d439f8cf558ac046955f42c088142965db6c3ff80fd2578b59f\\\"},{\\\"content\\\":\\\"// SPDX-License-Identifier: MIT\\\\ninterface Object {}\\\\ninterface Function {}\\\\ninterface CallableFunction {}\\\\ninterface NewableFunction {}\\\\ninterface IArguments {}\\\\ninterface String {}\\\\ninterface Number {}\\\\ninterface Boolean {}\\\\ninterface RegExp {}\\\\ninterface Array<T> { [n: number]: T; length: number; }\\\\ntype i8 = number;\\\\ntype i16 = number;\\\\ntype i32 = number;\\\\ntype i64 = number;\\\\ntype isize = number;\\\\ntype u8 = number;\\\\ntype u16 = number;\\\\ntype u32 = number;\\\\ntype u64 = number;\\\\ntype usize = number;\\\\ntype f32 = number;\\\\ntype f64 = number;\\\\ntype bool = boolean;\\\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\\\ninterface ClassDecoratorContext<C> {\\\\n  readonly kind: \\\\\\\"class\\\\\\\";\\\\n  readonly name: string | undefined;\\\\n  addInitializer(initializer: (this: C) => void): void;\\\\n}\\\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\\\n\\\",\\\"path\\\":\\\"/src/minimal-arrays-v8.d.ts\\\",\\\"sha256\\\":\\\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\\\"},{\\\"content\\\":\\\"declare const component: typeof tsfgComponent;\\\\ndeclare function system(target: unknown): unknown;\\\\ninterface Symbol {}\\\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\\\ninterface Array<T> extends Iterable<T> {}\\\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\\\ninterface Query<T extends unknown[]> {\\\\n readonly __query: T;\\\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\\\n}\\\\ntype Read<T> = SystemQueryReadView<T>;\\\\ntype Write<T> = T;\\\\n\\\",\\\"path\\\":\\\"/src/system-query-context.d.ts\\\",\\\"sha256\\\":\\\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\\\"}],\\\"rootFile\\\":\\\"/src/main.ts\\\",\\\"sourceRoot\\\":\\\"/src\\\",\\\"target\\\":{\\\"llvmDataLayout\\\":\\\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\\\",\\\"pointerBits\\\":\\\"64\\\",\\\"target\\\":\\\"windows-x86_64-msvc\\\",\\\"triple\\\":\\\"x86_64-pc-windows-msvc\\\"}},\\\"schemaHash\\\":\\\"sha256:32326256ba49bb78f12118d211b520