  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": false,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["eng/**/*.mjs", "src/**/*.mjs", "tooling/conformance/**/*.mjs", "tests/r00/**/*.mjs", "tests/r01/**/*.mjs", "tests/r02b/**/*.mjs"]
}
