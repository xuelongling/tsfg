# Configuration declarations only: no source bodies or generator expressions are
# evaluated here. Missing declarations still fail CMake's normal Generate step.
include_guard(GLOBAL)

if(NOT DEFINED TSFG_CONFIGURATION_SOURCES)
  message(FATAL_ERROR "Static configuration source metadata requires its stage output")
endif()
cmake_path(ABSOLUTE_PATH TSFG_CONFIGURATION_SOURCES NORMALIZE OUTPUT_VARIABLE _tsfg_output)
set(_tsfg_expected "${CMAKE_BINARY_DIR}/../configuration-sources.json")
cmake_path(NORMAL_PATH _tsfg_expected)
if(NOT _tsfg_output STREQUAL _tsfg_expected)
  message(FATAL_ERROR "Configuration source metadata must stay in the current stage")
endif()
set_property(GLOBAL PROPERTY TSFG_CONFIGURATION_SOURCES_OUTPUT "${_tsfg_output}")

function(tsfg_configuration_json value output)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  # JSON requires every control byte to be escaped, including literal newlines.
  set(_hex "0123456789abcdef")
  foreach(_code RANGE 1 31)
    string(ASCII ${_code} _control)
    math(EXPR _high "${_code} / 16")
    math(EXPR _low "${_code} % 16")
    string(SUBSTRING "${_hex}" ${_high} 1 _high)
    string(SUBSTRING "${_hex}" ${_low} 1 _low)
    string(REPLACE "${_control}" "\\u00${_high}${_low}" value "${value}")
  endforeach()
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(tsfg_configuration_directory directory output)
  set(_rows "")
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    foreach(_property IN ITEMS TYPE SOURCE_DIR BINARY_DIR SOURCES INTERFACE_SOURCES)
      get_property(_set TARGET "${_target}" PROPERTY "${_property}" SET)
      if(NOT _set)
        set(_${_property} "null")
      else()
        get_target_property(_value "${_target}" "${_property}")
        tsfg_configuration_json("${_value}" _${_property})
      endif()
    endforeach()
    tsfg_configuration_json("${_target}" _name)
    if(NOT _rows STREQUAL "")
      string(APPEND _rows ",")
    endif()
    string(APPEND _rows "{\"name\":${_name},\"type\":${_TYPE},\"sourceDirectory\":${_SOURCE_DIR},\"binaryDirectory\":${_BINARY_DIR},\"sourcesRaw\":${_SOURCES},\"interfaceSourcesRaw\":${_INTERFACE_SOURCES},\"resolution\":\"unresolved-target-properties\",\"generatedStatus\":\"UNKNOWN:not-queried\"}")
  endforeach()
  get_property(_directories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _directories)
    tsfg_configuration_directory("${_child}" _child_rows)
    if(NOT _child_rows STREQUAL "")
      if(NOT _rows STREQUAL "")
        string(APPEND _rows ",")
      endif()
      string(APPEND _rows "${_child_rows}")
    endif()
  endforeach()
  set(${output} "${_rows}" PARENT_SCOPE)
endfunction()

function(tsfg_capture_configuration_sources)
  get_property(_output GLOBAL PROPERTY TSFG_CONFIGURATION_SOURCES_OUTPUT)
  if(EXISTS "${_output}")
    message(FATAL_ERROR "Configuration source metadata already exists")
  endif()
  tsfg_configuration_directory("${CMAKE_SOURCE_DIR}" _targets)
  tsfg_configuration_json("${CMAKE_SOURCE_DIR}" _source)
  tsfg_configuration_json("${CMAKE_BINARY_DIR}" _binary)
  file(WRITE "${_output}" "{\"schemaVersion\":\"1\",\"kind\":\"configuration-source-declarations\",\"sourceDirectory\":${_source},\"binaryDirectory\":${_binary},\"qualification\":\"raw configured target properties; no body reads, path resolution, generator-expression evaluation or final dependency qualification\",\"targets\":[${_targets}]}\n")
endfunction()

# The top directory is still active here. The deferred call sees targets added
# by subsequent subdirectories and runs before Generate's source-presence check.
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL tsfg_capture_configuration_sources)
