# SPDX-License-Identifier: MIT
# Keep FindPython and LLVM's execute_process probes on the verified interpreter,
# while preserving Python3_EXECUTABLE as the exact original E-drive executable.
include_guard(GLOBAL)
if(NOT TSFG_VERIFIED_PYTHON OR NOT IS_ABSOLUTE "${TSFG_VERIFIED_PYTHON}")
  message(FATAL_ERROR "[mlir-python-integrity] explicit verified Python required")
endif()

function(execute_process)
  set(_tsfg_python_args)
  set(_tsfg_after_command FALSE)
  set(_tsfg_output_variables)
  set(_tsfg_after_variable FALSE)
  math(EXPR _tsfg_last_arg "${ARGC} - 1")
  foreach(_tsfg_index RANGE 0 ${_tsfg_last_arg})
    set(_tsfg_arg "${ARGV${_tsfg_index}}")
    string(REPLACE ";" "\\;" _tsfg_escaped "${_tsfg_arg}")
    list(APPEND _tsfg_python_args "${_tsfg_escaped}")
    if(_tsfg_after_variable)
      list(APPEND _tsfg_output_variables "${_tsfg_arg}")
    endif()
    if(_tsfg_arg MATCHES "^(OUTPUT_VARIABLE|ERROR_VARIABLE|RESULT_VARIABLE|RESULTS_VARIABLE)$")
      set(_tsfg_after_variable TRUE)
    else()
      set(_tsfg_after_variable FALSE)
    endif()
    if(_tsfg_after_command AND _tsfg_arg STREQUAL TSFG_VERIFIED_PYTHON)
      list(APPEND _tsfg_python_args -I -B)
    endif()
    if(_tsfg_arg STREQUAL "COMMAND")
      set(_tsfg_after_command TRUE)
    else()
      set(_tsfg_after_command FALSE)
    endif()
  endforeach()
  _execute_process(${_tsfg_python_args})
  foreach(_tsfg_output_variable IN LISTS _tsfg_output_variables)
    set("${_tsfg_output_variable}" "${${_tsfg_output_variable}}" PARENT_SCOPE)
  endforeach()
endfunction()
