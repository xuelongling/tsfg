#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository=$(CDPATH= cd -- "$script_dir/.." && pwd)
cache=${TSFG_CACHE_DIR:-"$repository/.tsfg-cache"}
platform=linux-x86_64
lock_id=1f4160eba269402f43eb239bde453f59b0a5f844d86f19d71103289425f4c007
node_id=89af8424dd53e560b1933f87ba650d8bf57c83ca5a04600eefb31f416aabbae7
report=
expect_report=false
for argument do
  if [ "$expect_report" = true ]; then
    report=$argument
    break
  fi
  if [ "$argument" = --report ]; then
    expect_report=true
  fi
done

runtime_failure() {
  message='locked Node.js closure is missing or invalid; run tsfg-build prefetch'
  if [ -n "$report" ]; then
    parent=$(dirname -- "$report")
    temporary="$report.$$.tmp"
    if ! mkdir -p -- "$parent" ||
      ! printf '%s\n' "{\"command\":\"verify-workspace\",\"error\":{\"category\":\"lock/integrity\",\"code\":\"11\",\"issues\":[{\"code\":\"runtime-closure\",\"message\":\"$message\"}]},\"network\":\"offline\",\"schemaVersion\":\"1\",\"status\":\"failure\",\"telemetry\":false}" > "$temporary" ||
      ! mv -f -- "$temporary" "$report"; then
      rm -f -- "$temporary"
      printf '%s\n' 'cannot write Build Report for runtime closure failure' >&2
      exit 30
    fi
  fi
  printf '%s\n' "$message" >&2
  exit 11
}

usage_failure() {
  report_command=$1
  issue_code=$2
  message=$3
  if [ -n "$report" ]; then
    parent=$(dirname -- "$report")
    temporary="$report.$$.tmp"
    if ! mkdir -p -- "$parent" ||
      ! printf '%s\n' "{\"command\":\"$report_command\",\"error\":{\"category\":\"usage/configuration\",\"code\":\"2\",\"issues\":[{\"code\":\"$issue_code\",\"message\":\"$message\"}]},\"network\":\"disabled\",\"schemaVersion\":\"1\",\"status\":\"failure\",\"telemetry\":false}" > "$temporary" ||
      ! mv -f -- "$temporary" "$report"; then
      rm -f -- "$temporary"
      printf '%s\n' 'cannot write Build Report for unsupported operation' >&2
      exit 30
    fi
  fi
  printf '%s\n' "$message" >&2
  exit 2
}

valid_verify_arguments() {
  seen_workspace=false
  seen_manifest_url=false
  seen_manifest_revision=false
  seen_manifest=false
  seen_report=false
  shift
  while [ "$#" -gt 0 ]; do
    option=$1
    shift
    if [ "$#" -eq 0 ] || [ -z "$1" ]; then
      return 1
    fi
    case "$option" in
      --workspace)
        [ "$seen_workspace" = false ] || return 1
        seen_workspace=true
        ;;
      --manifest-url)
        [ "$seen_manifest_url" = false ] || return 1
        seen_manifest_url=true
        ;;
      --manifest-revision)
        [ "$seen_manifest_revision" = false ] || return 1
        seen_manifest_revision=true
        ;;
      --manifest)
        [ "$seen_manifest" = false ] || return 1
        seen_manifest=true
        ;;
      --report)
        [ "$seen_report" = false ] || return 1
        seen_report=true
        ;;
      *) return 1 ;;
    esac
    shift
  done
  [ "$seen_workspace" = true ] &&
    [ "$seen_manifest_url" = true ] &&
    [ "$seen_manifest_revision" = true ] &&
    [ "$seen_manifest" = true ]
}

if [ "${1:-}" = prefetch ]; then
  exec node "$script_dir/tsfg-build.mjs" "$@" \
    --lock "$script_dir/toolchains.lock.json" \
    --cache "$cache" \
    --platform "$platform"
fi
if [ "${1:-}" != verify-workspace ]; then
  usage_failure unsupported unsupported-operation 'unsupported operation'
fi
if ! valid_verify_arguments "$@"; then
  usage_failure verify-workspace invalid-configuration 'invalid verify-workspace arguments'
fi

active="$cache/active/$platform"
if [ ! -f "$active" ]; then
  runtime_failure
fi
closure=$(sed -n '1p' "$active")
if [ "$closure" != "closures/sha256/$lock_id/$platform" ]; then
  runtime_failure
fi
node_path="$cache/$closure/node/bin/node"
if [ ! -x "$node_path" ]; then
  runtime_failure
fi
if [ ! -x /usr/bin/sha256sum ]; then
  runtime_failure
fi
node_actual=$(/usr/bin/sha256sum "$node_path") || runtime_failure
node_actual=${node_actual%% *}
if [ "$node_actual" != "$node_id" ]; then
  runtime_failure
fi
TSFG_GIT=$(command -v git || true)
export TSFG_GIT
TSFG_RUNTIME_LOCK="$script_dir/toolchains.lock.json"
TSFG_RUNTIME_CACHE=$cache
TSFG_RUNTIME_PLATFORM=$platform
export TSFG_RUNTIME_LOCK TSFG_RUNTIME_CACHE TSFG_RUNTIME_PLATFORM
exec "$node_path" "$script_dir/tsfg-build.mjs" "$@"
