#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository=$(CDPATH= cd -- "$script_dir/.." && pwd)
cache=${TSFG_CACHE_DIR:-"$repository/.tsfg-cache"}
platform=linux-x86_64-gnu
lock_id=99df577d8c78ae99ffe8ee04dc2034521b023e9e19b177f696d1f0fa2412e9d5
node_id=89af8424dd53e560b1933f87ba650d8bf57c83ca5a04600eefb31f416aabbae7
command=${1:-}
report=
expect_report=false
for argument do
  if [ "$expect_report" = true ]; then
    report=$argument
    break
  fi
  if [ "$argument" = --report ]; then
    expect_report=true
  fi
done

runtime_failure() {
  message='locked Node.js closure is missing or invalid; run tsfg-build prefetch'
  if [ -n "$report" ]; then
    parent=$(dirname -- "$report")
    temporary="$report.$$.tmp"
    if ! mkdir -p -- "$parent" ||
      ! printf '%s\n' "{\"command\":\"$command\",\"error\":{\"category\":\"lock/integrity\",\"code\":\"11\",\"issues\":[{\"code\":\"runtime-closure\",\"message\":\"$message\"}]},\"network\":\"offline\",\"schemaVersion\":\"1\",\"status\":\"failure\",\"telemetry\":false}" > "$temporary" ||
      ! mv -f -- "$temporary" "$report"; then
      rm -f -- "$temporary"
      printf '%s\n' 'cannot write Build Report for runtime closure failure' >&2
      exit 30
    fi
  fi
  printf '%s\n' "$message" >&2
  exit 11
}

usage_failure() {
  report_command=$1
  issue_code=$2
  message=$3
  if [ -n "$report" ]; then
    parent=$(dirname -- "$report")
    temporary="$report.$$.tmp"
    if ! mkdir -p -- "$parent" ||
      ! printf '%s\n' "{\"command\":\"$report_command\",\"error\":{\"category\":\"usage/configuration\",\"code\":\"2\",\"issues\":[{\"code\":\"$issue_code\",\"message\":\"$message\"}]},\"network\":\"disabled\",\"schemaVersion\":\"1\",\"status\":\"failure\",\"telemetry\":false}" > "$temporary" ||
      ! mv -f -- "$temporary" "$report"; then
      rm -f -- "$temporary"
      printf '%s\n' 'cannot write Build Report for unsupported operation' >&2
      exit 30
    fi
  fi
  printf '%s\n' "$message" >&2
  exit 2
}

valid_verify_arguments() {
  seen_workspace=false
  seen_manifest_url=false
  seen_manifest_revision=false
  seen_manifest=false
  seen_report=false
  manifest_revision=
  manifest_name=
  shift
  while [ "$#" -gt 0 ]; do
    option=$1
    shift
    if [ "$#" -eq 0 ] || [ -z "$1" ]; then
      return 1
    fi
    case "$option" in
      --workspace)
        [ "$seen_workspace" = false ] || return 1
        seen_workspace=true
        ;;
      --manifest-url)
        [ "$seen_manifest_url" = false ] || return 1
        seen_manifest_url=true
        ;;
      --manifest-revision)
        [ "$seen_manifest_revision" = false ] || return 1
        seen_manifest_revision=true
        manifest_revision=$1
        ;;
      --manifest)
        [ "$seen_manifest" = false ] || return 1
        seen_manifest=true
        manifest_name=$1
        ;;
      --report)
        [ "$seen_report" = false ] || return 1
        seen_report=true
        ;;
      *) return 1 ;;
    esac
    shift
  done
  [ "$seen_workspace" = true ] &&
    [ "$seen_manifest_url" = true ] &&
    [ "$seen_manifest_revision" = true ] &&
    [ "$seen_manifest" = true ] || return 1
  [ "${#manifest_revision}" -eq 40 ] || return 1
  case "$manifest_revision" in *[!0-9a-f]*) return 1 ;; esac
  rest=$manifest_name
  segment=
  while [ -n "$rest" ]; do
    character=${rest%"${rest#?}"}
    rest=${rest#?}
    case "$character" in
      /|\\)
        [ -n "$segment" ] && [ "$segment" != .. ] || return 1
        segment=
        ;;
      *) segment=$segment$character ;;
    esac
  done
  [ -n "$segment" ] && [ "$segment" != .. ]
}

valid_smoke_arguments() {
  expected_command=$1
  shift
  [ "${1:-}" = "$expected_command" ] || return 1
  shift
  seen_target=false
  seen_profile=false
  seen_out=false
  seen_input=false
  seen_report=false
  target=
  profile=
  while [ "$#" -gt 0 ]; do
    option=$1
    shift
    if [ "$#" -eq 0 ] || [ -z "$1" ]; then
      return 1
    fi
    case "$option" in
      --target)
        [ "$seen_target" = false ] || return 1
        seen_target=true
        target=$1
        ;;
      --profile)
        [ "$seen_profile" = false ] || return 1
        seen_profile=true
        profile=$1
        ;;
      --out)
        [ "$seen_out" = false ] || return 1
        seen_out=true
        ;;
      --input)
        [ "$expected_command" = package ] || return 1
        [ "$seen_input" = false ] || return 1
        seen_input=true
        ;;
      --report)
        [ "$seen_report" = false ] || return 1
        seen_report=true
        ;;
      *) return 1 ;;
    esac
    shift
  done
  [ "$seen_target" = true ] &&
    [ "$seen_profile" = true ] &&
    [ "$seen_out" = true ] &&
    { [ "$expected_command" != package ] || [ "$seen_input" = true ]; } &&
    [ "$target" = linux-x86_64-gnu ] &&
    [ "$profile" = debug ]
}

if [ "${1:-}" = prefetch ]; then
  exec node "$script_dir/tsfg-build.mjs" "$@" \
    --lock "$script_dir/toolchains.lock.json" \
    --cache "$cache" \
    --platform "$platform"
fi
if [ "$command" != verify-workspace ] && [ "$command" != build ] && [ "$command" != test ] && [ "$command" != package ]; then
  usage_failure unsupported unsupported-operation 'unsupported operation'
fi
if [ "$command" = verify-workspace ] && ! valid_verify_arguments "$@"; then
  usage_failure verify-workspace invalid-configuration 'invalid verify-workspace arguments'
fi
if { [ "$command" = build ] || [ "$command" = test ] || [ "$command" = package ]; } && ! valid_smoke_arguments "$command" "$@"; then
  usage_failure "$command" invalid-configuration "invalid $command arguments"
fi

active="$cache/active/$platform"
if [ ! -f "$active" ]; then
  runtime_failure
fi
closure=$(sed -n '1p' "$active")
if [ "$closure" != "closures/sha256/$lock_id/$platform" ]; then
  runtime_failure
fi
node_path="$cache/$closure/node/bin/node"
if [ ! -x "$node_path" ]; then
  runtime_failure
fi
if [ ! -x /usr/bin/sha256sum ]; then
  runtime_failure
fi
node_actual=$(/usr/bin/sha256sum "$node_path") || runtime_failure
node_actual=${node_actual%% *}
if [ "$node_actual" != "$node_id" ]; then
  runtime_failure
fi
TSFG_GIT=$(command -v git || true)
export TSFG_GIT
TSFG_RUNTIME_LOCK="$script_dir/toolchains.lock.json"
TSFG_RUNTIME_CACHE=$cache
TSFG_RUNTIME_PLATFORM=$platform
export TSFG_RUNTIME_LOCK TSFG_RUNTIME_CACHE TSFG_RUNTIME_PLATFORM
exec "$node_path" "$script_dir/tsfg-build.mjs" "$@"
