on unused(v:i32):i32{return v+1;}\\nexport {};\\n\",\"path\":\"/src/helpers.ts\",\"sha256\":\"cf79a175eb7d48da70e55365d3fda6e06ef2c5cb2cd0b9d0cfbfea04d5025507\"},{\"content\":\"import {scaled as gain} from './helpers';\\n// complete architecture Query source: emoji 😀\\n@component\\nexport class Position { x: f32 = 0; y: f32 = 0; }\\n@component\\nexport class Velocity { x: f32 = 0; y: f32 = 0; }\\n@system\\nexport function integrate(q: Query<[Write<Position>, Read<Velocity>]>, dt: f32): void {\\n for(const [p,v] of q){\\n  p.x += gain(v.x, dt);\\n  p.y += v.y * dt;\\n }\\n}\\n\\nfunction unused(v:i32):i32{return v+1;}\\nclass Box {value:i32=1;}\\n\",\"path\":\"/src/main.ts\",\"sha256\":\"3a2a9c22beeee080a131ddf372a74786c817ae638096519ea769351fae57252f\"},{\"content\":\"// SPDX-License-Identifier: MIT\\ninterface Object {}\\ninterface Function {}\\ninterface CallableFunction {}\\ninterface NewableFunction {}\\ninterface IArguments {}\\ninterface String {}\\ninterface Number {}\\ninterface Boolean {}\\ninterface RegExp {}\\ninterface Array<T> { [n: number]: T; length: number; }\\ntype i8 = number;\\ntype i16 = number;\\ntype i32 = number;\\ntype i64 = number;\\ntype isize = number;\\ntype u8 = number;\\ntype u16 = number;\\ntype u32 = number;\\ntype u64 = number;\\ntype usize = number;\\ntype f32 = number;\\ntype f64 = number;\\ntype bool = boolean;\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\ninterface ClassDecoratorContext<C> {\\n  readonly kind: \\\"class\\\";\\n  readonly name: string | undefined;\\n  addInitializer(initializer: (this: C) => void): void;\\n}\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\n\",\"path\":\"/src/minimal-arrays-v8.d.ts\",\"sha256\":\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\"},{\"content\":\"declare const component: typeof tsfgComponent;\\ndeclare function system(target: unknown): unknown;\\ninterface Symbol {}\\ndeclare const Symbol: { readonly iterator: unique symbol; };\\ninterface SystemQueryIteratorResult<T> { value: T; done?: boolean; }\\ninterface SystemQueryIterator<T> { next(): SystemQueryIteratorResult<T>; }\\ninterface Iterable<T, TReturn = unknown, TNext = unknown> { [Symbol.iterator](): SystemQueryIterator<T>; }\\ninterface Array<T> extends Iterable<T> {}\\ntype SystemQueryReadView<T> = { readonly [K in keyof T]: T[K] extends object ? SystemQueryReadView<T[K]> : T[K] };\\ntype SystemQueryRow<T extends unknown[]> = { [K in keyof T]: T[K] };\\ninterface Query<T extends unknown[]> {\\n readonly __query: T;\\n [Symbol.iterator](): SystemQueryIterator<SystemQueryRow<T>>;\\n}\\ntype Read<T> = SystemQueryReadView<T>;\\ntype Write<T> = T;\\n\",\"path\":\"/src/system-query-context.d.ts\",\"sha256\":\"7fefda1fbc86170ff7c6479a4f3646ff8194b8dc5f7476107763c3c11fab604b\"}],\"rootFile\":\"/src/main.ts\",\"sourceRoot\":\"/src\",\"target\":{\"llvmDataLayout\":\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\",\"pointerBits\":\"64\",\"target\":\"windows-x86_64-msvc\",\"triple\":\"x86_64-pc-windows-msvc\"}},\"schemaHash\":\"sha256:32326256ba49bb78f12118d211b520c0f84aa8001422004e8d17dce86d8b814e\",\"version\":6}"} {
