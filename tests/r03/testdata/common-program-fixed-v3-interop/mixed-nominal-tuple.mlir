],\"viewType\":\"u32\"},{\"functionId\":\"sha256:62142e7470bde3c4cddfd07f743494316b1766166ec2902feebfd637ed77a958\",\"origin\":{\"end\":325,\"source\":\"/src/main.ts\",\"start\":319},\"parameterBinding\":\"sha256:0410469461679546c6a982459afeff47cf1c394b3f54eb3ee976a42b10ead9eb\",\"roots\":[],\"viewType\":\"i32\"}],\"exports\":[{\"functionId\":\"sha256:4dc170db42caa47f14f03edd2e4b083e802b6b0b4e22f6f631e4c7061ff2afaa\",\"name\":\"left\"},{\"functionId\":\"sha256:62142e7470bde3c4cddfd07f743494316b1766166ec2902feebfd637ed77a958\",\"name\":\"ordinary\"},{\"functionId\":\"sha256:310012321ce586048d77a6f7d1d75bb00f3c33f2f8217e8b79108106f6e18702\",\"name\":\"right\"},{\"functionId\":\"sha256:561ba28cd3b79e05f414d32be2923c3f7f501c9ac4bbc0173a3ab494026854b6\",\"name\":\"view\"}],\"files\":[{\"byteLength\":102,\"content\":\"export { Delta, Box, run } from './data';\\nexport { add, bump, leftTotal, rightTotal } from './state';\\n\",\"path\":\"/src/barrel.ts\",\"sha256\":\"125c3d2b5e836ee4a47b02844f8ddbd2acefbd39f8e9cc6bb151ac9c2281a24a\",\"utf16Length\":102},{\"byteLength\":182,\"content\":\"@tsfgValue\\nexport class Delta { n: i32 = 0; }\\nexport class Box { n: i32 = 0; }\\nexport function run(i:u32):i32{const a:i32[]=[1,2];const s:ReadSpan<i32>=readSpan(a,0,2);return s[i];}\\n\",\"path\":\"/src/data.ts\",\"sha256\":\"7171e4cf5dc9ddefc07d311fab881df0c352b90d6778855890c2aaec42de763c\",\"utf16Length\":182},{\"byteLength\":536,\"content\":\"// 😀 Aliases retain original declarations across the complete Program.\\nimport { Delta, Box, run as readLocal } from './barrel';\\nimport * as counters from './state';\\nexport function left(d: Delta): i32 { return counters.add(d); }\\nexport function right(x: i32): i32 { return counters.bump(x); }\\nexport function ordinary(x: i32): i32 {\\n  const box: Box = new Box();\\n  try { throw x; }\\n  catch (caught) { box.n = caught as i32; return box.n; }\\n  finally { counters.bump(0); }\\n}\\nexport function view(i: u32): i32 { return readLocal(i); }\\n\",\"path\":\"/src/main.ts\",\"sha256\":\"913cba48bde52090f2b686ca73eb69b2be7068df724e7b9f2658a0d61dcc4e76\",\"utf16Length\":534},{\"byteLength\":1025,\"content\":\"// SPDX-License-Identifier: MIT\\ninterface Object {}\\ninterface Function {}\\ninterface CallableFunction {}\\ninterface NewableFunction {}\\ninterface IArguments {}\\ninterface String {}\\ninterface Number {}\\ninterface Boolean {}\\ninterface RegExp {}\\ninterface Array<T> { [n: number]: T; length: number; }\\ntype i8 = number;\\ntype i16 = number;\\ntype i32 = number;\\ntype i64 = number;\\ntype isize = number;\\ntype u8 = number;\\ntype u16 = number;\\ntype u32 = number;\\ntype u64 = number;\\ntype usize = number;\\ntype f32 = number;\\ntype f64 = number;\\ntype bool = boolean;\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\ninterface ClassDecoratorContext<C> {\\n  readonly kind: \\\"class\\\";\\n  readonly name: string | undefined;\\n  addInitializer(initializer: (this: C) => void): void;\\n}\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\n\",\"path\":\"/src/minimal-arrays-v8.d.ts\",\"sha256\":\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\",\"utf16Length\":1025},{\"byteLength\":256,\"content\":\"import { Delta } from './data';\\nexport let leftTotal: i32 = 0;\\nexport let rightTotal: i32 = leftTotal + 1;\\nexport function add(d: Delta): i32 { leftTotal += d.n; return leftTotal; }\\nexport function bump(x: i32): i32 { rightTotal += x; return rightTotal; }\\n\",\"path\":\"/src/state.ts\",\"sha256\":\"8bf4df5068b4adbe5c763cc22327fda1c2d9b57b3bc9475e58eb92cd549844af\",\"utf16Length\":256}],\"functions\":[{\"access\":\"public\",\"bindings\":[{\"annotationRange\":{\"end\":123,\"start\":118},\"declarationRange\":{\"end\":129,\"start\":116},\"d