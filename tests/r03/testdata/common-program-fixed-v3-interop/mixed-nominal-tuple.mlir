😀 Aliases retain original declarations across the complete Program.\\nimport { Delta, Box, run as readLocal } from './barrel';\\nimport * as counters from './state';\\nexport function left(d: Delta): i32 { return counters.add(d); }\\nexport function right(x: i32): i32 { return counters.bump(x); }\\nexport function ordinary(x: i32): i32 {\\n  const box: Box = new Box();\\n  try { throw x; }\\n  catch (caught) { box.n = caught as i32; return box.n; }\\n  finally { counters.bump(0); }\\n}\\nexport function view(i: u32): i32 { return readLocal(i); }\\n\",\"hash\":\"sha256:913cba48bde52090f2b686ca73eb69b2be7068df724e7b9f2658a0d61dcc4e76\",\"path\":\"/src/main.ts\"},{\"content\":\"// SPDX-License-Identifier: MIT\\ninterface Object {}\\ninterface Function {}\\ninterface CallableFunction {}\\ninterface NewableFunction {}\\ninterface IArguments {}\\ninterface String {}\\ninterface Number {}\\ninterface Boolean {}\\ninterface RegExp {}\\ninterface Array<T> { [n: number]: T; length: number; }\\ntype i8 = number;\\ntype i16 = number;\\ntype i32 = number;\\ntype i64 = number;\\ntype isize = number;\\ntype u8 = number;\\ntype u16 = number;\\ntype u32 = number;\\ntype u64 = number;\\ntype usize = number;\\ntype f32 = number;\\ntype f64 = number;\\ntype bool = boolean;\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\ninterface ClassDecoratorContext<C> {\\n  readonly kind: \\\"class\\\";\\n  readonly name: string | undefined;\\n  addInitializer(initializer: (this: C) => void): void;\\n}\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\n\",\"hash\":\"sha256:0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\",\"path\":\"/src/minimal-arrays-v8.d.ts\"},{\"content\":\"import { Delta } from './data';\\nexport let leftTotal: i32 = 0;\\nexport let rightTotal: i32 = leftTotal + 1;\\nexport function add(d: Delta): i32 { leftTotal += d.n; return leftTotal; }\\nexport function bump(x: i32): i32 { rightTotal += x; return rightTotal; }\\n\",\"hash\":\"sha256:8bf4df5068b4adbe5c763cc22327fda1c2d9b57b3bc9475e58eb92cd549844af\",\"path\":\"/src/state.ts\"}],\"target\":{\"llvmDataLayout\":\"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\",\"pointerBits\":\"64\",\"target\":\"windows-x86_64-msvc\",\"triple\":\"x86_64-pc-windows-msvc\"},\"types\":[{\"construction\":{\"access\":\"public\",\"functionId\":null,\"id\":\"sha256:fc078291ec1e3a0a9536f84f6741c60ccc9ae81435943b5b6bd535e1d6231a8b\",\"implicitForward\":null,\"initializationFields\":[\"sha256:8b768eca444cd8721647c236d4f6e7c24b9a76f731e1f0e6a739e24a7f894033\"],\"initializationPhase\":\"before-body\",\"kind\":\"implicit-base\",\"origin\":{\"end\":45,\"source\":\"/src/data.ts\",\"start\":0},\"parameters\":[],\"signature\":{\"parameters\":[],\"returnType\":\"sha256:598d0d4cdd3897fcf3a991d2feaaf922027686148fcc42776c14007c5eef8b63\"},\"sourceSignature\":{\"declarationRange\":{\"end\":45,\"start\":0},\"id\":\"sha256:880df5958fb375d3b94acbf1269151e2fbf5d59d1cbe699f10d42634fee53a42\",\"parameters\":[],\"returnType\":\"nominal:c4c20e0068a74de002a7d446d444bf5509a4f3d72949a015fb975240658a1e0b\",\"sourcePath\":\"/src/data.ts\"}},\"fields\":[{\"access\":\"public\",\"id\":\"sha256:8b768eca444cd8721647c236d4f6e7c24b9a76f731e1f0e6a739e24a7f894033\",\"index\":0,\"initializer\":{\"decimal\":\"0\",\"declaredType\":\"sha256:a499279eb079e9a530729c0e20165237b946527f01f48d1426b927e2c2e7d727\",\"kind\":\"numericLiteral\",\"range\":{\"end\":42,\"start\":41},\"token\":\"0\",\"type\":\"sha256:a499279eb079e9a530729c0e20165237b946527f01f48d1426b927e2c2e7d727\"},\"name\":\"n\",\"origin\":{\"end\":43,\"source\":\"/src/data.ts\",\"start\":32},\"readonly\":false,\"sourceBinding\":\"sha256:fd60bc10ba049a5d2c375e3865570218c76b9e5f19dc1384c3f2827be171b729\",\"type\":\"