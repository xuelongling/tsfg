n;\\n  }\\n}\\n\\nclass X { n: i32 = 1; next: X[] = []; }\\nclass Y { n: i32 = 2; next: Y[] = []; }\\nclass Base {\\n  n: i32 = 0;\\n  constructor(seed: i32) { this.n = seed; }\\n}\\nclass Derived extends Base { extra: i32 = 2; }\\n\\nfunction convert(a: X): Y { return a; }\\nexport function compatibilityEntry(v: Y): i32 { return v.n; }\\nexport function relationRoundtrip(a: X): i32 {\\n  const b: Y = convert(a);\\n  return compatibilityEntry(b);\\n}\\nexport function derivedEntry(seed: i32): i32 {\\n  const d: Derived = new Derived(seed);\\n  return d.n + d.extra;\\n}\\n\",\"path\":\"/src/main.ts\",\"sha256\":\"3d9806429b949289ff808b228aceac45b51c14e53d9b797405330cf954b1f380\",\"utf16Length\":1074},{\"byteLength\":1025,\"content\":\"// SPDX-License-Identifier: MIT\\ninterface Object {}\\ninterface Function {}\\ninterface CallableFunction {}\\ninterface NewableFunction {}\\ninterface IArguments {}\\ninterface String {}\\ninterface Number {}\\ninterface Boolean {}\\ninterface RegExp {}\\ninterface Array<T> { [n: number]: T; length: number; }\\ntype i8 = number;\\ntype i16 = number;\\ntype i32 = number;\\ntype i64 = number;\\ntype isize = number;\\ntype u8 = number;\\ntype u16 = number;\\ntype u32 = number;\\ntype u64 = number;\\ntype usize = number;\\ntype f32 = number;\\ntype f64 = number;\\ntype bool = boolean;\\ninterface ReadSpan<T> { readonly [n: number]: T; readonly length: u32; }\\ndeclare function readSpan<T>(owner: T[], start: u32, length: u32): ReadSpan<T>;\\ninterface ClassDecoratorContext<C> {\\n  readonly kind: \\\"class\\\";\\n  readonly name: string | undefined;\\n  addInitializer(initializer: (this: C) => void): void;\\n}\\ndeclare function tsfgValue<C>(target: C, context: ClassDecoratorContext<C>): void;\\ndeclare function tsfgComponent<C>(target: C, context: ClassDecoratorContext<C>): void;\\n\",\"path\":\"/src/minimal-arrays-v8.d.ts\",\"sha256\":\"0d30a2f626bb7455decf36f5a7a8d3308d4254100d2cb10e7c0d2353d28b141e\",\"utf16Length\":1025}],\"functions\